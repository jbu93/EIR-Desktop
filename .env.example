# .env.example · Plantilla para la versión de código abierto (BYOK local).
#
# Por defecto el desktop usa un mock 100% offline (sin claves). Estas
# variables solo se leen si las activas explícitamente.
#
# Copia este archivo a .env y rellena según tu caso.

# ----- Kill-switch BYOK (M-051, default APAGADO — L10) -----
# Con EIR_OPENCODE_ENABLED apagado o ausente, el desktop usa ClienteMockSandbox.
# Con =1, usa tu opencode serve local (BYOK: tus propias claves de proveedor).
EIR_OPENCODE_ENABLED=0

# ----- Si activas BYOK: conexión a opencode serve local -----
OPENCODE_SERVER_URL=http://127.0.0.1:4096
OPENCODE_SERVER_USER=opencode
OPENCODE_SERVER_PASSWORD=

# ----- Gateway cloud EIR (fase futura, no operativo hoy) -----
EIR_CLOUD_GATEWAY=https://eirdr.com/api/v1/inference
EIR_DESKTOP_PORT=5175

# ----- Seguridad sandbox -----
EIR_AGENTE_LOOP_ENABLED=1
